    "/api/submit/batch": {
      "post": {
        "operationId": "submitEstimateBatch",
        "summary": "Estimate an ordered batch of chemicals",
        "description": "Validates and estimates 1 to 100 independent requests in source order. A syntactically accepted batch always returns HTTP 200; item failures occupy null result slots and are reported by source index.",
        "tags": [
          "Calculations"
        ],
        "requestBody": {
          "required": true,
          "x-epi-max-body-bytes": 1048576,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/BatchEstimateRequest"
                }
              },
              "examples": {
                "allEcosarProfiles": {
                  "summary": "One valid item for each ECOSAR interface mode",
                  "value": [
                    {"modules": ["ecosar.organics", "logKow", "physicalProperties", "waterSolubilityFromLogKow"], "smiles": "CCO"},
                    {"modules": ["ecosar.dye"], "molecularWeight": 350, "waterSolubility": 10, "ethoxylate": 0},
                    {"modules": ["ecosar.nonionic-surfactant"], "mainCarbons": 12, "branchedCarbons": 0, "branches": 0, "propoxyGroups": 0, "ethoxylate": 5, "waterSolubility": 100, "logKow": 3.1, "molecularWeight": 320},
                    {"modules": ["ecosar.anionic-surfactant"], "carbonChainLength": 12, "waterSolubility": 100},
                    {"modules": ["ecosar.amphoteric-surfactant"], "carbonChainLength": 12, "ethoxylate": 0, "waterSolubility": 100},
                    {"modules": ["ecosar.cationic-surfactant"], "carbonChainLength": 12, "waterSolubility": 100},
                    {"modules": ["ecosar.anionic-polymer"], "solubilityType": "INSOLUBLE"},
                    {"modules": ["ecosar.amphoteric-polymer"], "solubilityType": "SOLUBLE", "polymerType": "carbon", "amineNitrogens": 1.5, "cationAnionRatio": 1},
                    {"modules": ["ecosar.polycationic-polymer"], "polymerType": "carbon", "amineNitrogens": 1.5},
                    {"modules": ["ecosar.nonionic-polymer"], "solubilityType": "SOLUBLE", "averageMolecularWeight": 10000, "mw500Percentage": 5, "mw1000Percentage": 10}
                  ]
                },
                "mixedGeneralModules": {
                  "summary": "The endpoint is generic and accepts non-ECOSAR modules",
                  "value": [
                    {"modules": ["logKow"], "smiles": "CCO"},
                    {"modules": ["physicalProperties", "henrysLawConstant"], "smiles": "c1ccccc1"}
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete positional batch envelope, including any item-level failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchEstimateResponse"
                },
                "examples": {
                  "partialFailure": {
                    "summary": "The failed source row retains a null positional slot",
                    "value": {
                      "success": false,
                      "count": 2,
                      "results": [
                        {"parameters": {}, "chemicalProperties": {"smiles": "CCO"}},
                        null
                      ],
                      "errors": [
                        {"index": 1, "code": "missing_required", "field": "modules", "module": "request", "message": "modules is required and must be a non-empty JSON array."}
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "413": {
            "$ref": "#/components/responses/BatchTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/EstimateTimeout"
          }
        }
      }
    },
