    "schemas": {
      "BatchEstimateRequest": {
        "type": "object",
        "required": ["modules"],
        "additionalProperties": false,
        "properties": {
          "modules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "Selected calculations. Items run in canonical dependency order rather than submitted array order; use waterSolubilityProvider for the shared water-solubility choice.",
            "items": {
              "type": "string",
              "enum": [
                "logKow", "physicalProperties", "waterSolubilityFromLogKow",
                "waterSolubilityFromWaterNt", "henrysLawConstant", "logKoc",
                "atmosphericHalfLife", "biodegradationRate", "logKoa",
                "aerosolAdsorptionFraction", "dermalPermeability", "sewageTreatmentModel",
                "waterVolatilization", "fugacityModel", "hydrocarbonBiodegradationRate",
                "bioconcentration", "ecosar.organics", "ecosar.nonionic-surfactant",
                "ecosar.anionic-surfactant", "ecosar.cationic-surfactant",
                "ecosar.amphoteric-surfactant", "ecosar.dye", "ecosar.nonionic-polymer",
                "ecosar.anionic-polymer", "ecosar.amphoteric-polymer",
                "ecosar.polycationic-polymer", "fishBiotransformationRate", "hydrolysis",
                "analogIdentification"
              ]
            }
          },
          "smiles": {
            "type": "string",
            "description": "Raw structure input. A SMILES-only batch item is estimated without experimental results."
          },
          "cas": {
            "type": "string",
            "description": "CAS Registry Number. Only a CAS-identified batch item can resolve experimental results; CAS takes precedence when SMILES is also supplied."
          },
          "chemicalName": {"type": "string"},
          "waterSolubilityProvider": {"type": "string"},
          "solubilityType": {"type": "string"},
          "polymerType": {"type": "string"},
          "logKow": {"type": "number"},
          "molecularWeight": {"type": "number", "description": "Optional resolved molecular weight. Part of the complete positive VP/WSOL/MW triplet that enables the HENRYWIN VP/WSOL candidate."},
          "waterSolubilityMgPerL": {"type": "number", "description": "Optional resolved water solubility in mg/L. Its omission leaves structural HENRYWIN candidates available."},
          "waterSolubility": {"type": "number"},
          "vaporPressureMmHg": {"type": "number", "description": "Optional resolved vapor pressure in mmHg. Its omission leaves structural HENRYWIN candidates available."},
          "subcooledVaporPressureMmHg": {"type": "number"},
          "henryAtmM3PerMol": {"type": "number"},
          "logKoa": {"type": "number"},
          "koc": {"type": "number"},
          "meltingPointC": {"type": "number"},
          "boilingPointC": {"type": "number"},
          "vaporPressureTemperatureC": {"type": "number", "enum": [25], "default": 25, "description": "Fixed MPBPVP calculation temperature in °C; values other than 25 are rejected."},
          "aopRateConstant": {"type": "number"},
          "biowinScore": {"type": "number"},
          "biowin3": {"type": "number"},
          "biowin5": {"type": "number"},
          "tspUgPerM3": {"type": "number"},
          "theta": {"type": "number"},
          "waterConcentrationMgPerCm3": {"type": "number"},
          "waterConcentrationMgPerLiter": {"type": "number"},
          "eventFrequencyPerDay": {"type": "number"},
          "exposureDurationYears": {"type": "number"},
          "exposureFrequencyDaysPerYear": {"type": "number"},
          "skinSurfaceAreaCm2": {"type": "number"},
          "bodyWeightKg": {"type": "number"},
          "averagingTimeDays": {"type": "number"},
          "fractionAbsorbed": {"type": "number"},
          "eventDurationHours": {"type": "number"},
          "userKpCmPerHour": {"type": "number"},
          "halfLifeHoursPrimaryClarifier": {"type": "number"},
          "halfLifeHoursAerationVessel": {"type": "number"},
          "halfLifeHoursSettlingTank": {"type": "number"},
          "halfLifeAir": {"type": "number"},
          "halfLifeWater": {"type": "number"},
          "halfLifeSoil": {"type": "number"},
          "halfLifeSediment": {"type": "number"},
          "emissionRateAir": {"type": "number"},
          "emissionRateWater": {"type": "number"},
          "emissionRateSoil": {"type": "number"},
          "emissionRateSediment": {"type": "number"},
          "advectionTimeAir": {"type": "number"},
          "advectionTimeWater": {"type": "number"},
          "advectionTimeSoil": {"type": "number"},
          "advectionTimeSediment": {"type": "number"},
          "ohConcentrationE6OhPerCm3": {"type": "number"},
          "ozoneConcentrationE11MolPerCm3": {"type": "number"},
          "daylightHours": {"type": "number"},
          "riverWindMPerSec": {"type": "number"},
          "riverCurrentMPerSec": {"type": "number"},
          "riverDepthMeters": {"type": "number"},
          "lakeWindMPerSec": {"type": "number"},
          "lakeCurrentMPerSec": {"type": "number"},
          "lakeDepthMeters": {"type": "number"},
          "amineNitrogens": {"type": "number"},
          "cationAnionRatio": {"type": "number"},
          "mw500Percentage": {"type": "number"},
          "mw1000Percentage": {"type": "number"},
          "averageMolecularWeight": {"type": "number"},
          "carbonChainLength": {"type": "integer"},
          "mainCarbons": {"type": "integer"},
          "branchedCarbons": {"type": "integer"},
          "branches": {"type": "integer"},
          "propoxyGroups": {"type": "number"},
          "ethoxylate": {"type": "integer"},
          "removeMetals": {"type": "boolean"},
          "useSmiles": {"type": "boolean"}
        }
      },
      "BatchEstimateResponse": {
        "type": "object",
        "required": ["success", "count", "results", "errors"],
        "additionalProperties": false,
        "properties": {
          "success": {"type": "boolean"},
          "count": {"type": "integer", "minimum": 1, "maximum": 100},
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "allOf": [{"$ref": "#/components/schemas/EpiResults"}],
              "nullable": true
            }
          },
          "errors": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/BatchItemError"}
          }
        }
      },
      "BatchItemError": {
        "type": "object",
        "required": ["index", "code", "module", "message"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 99},
          "code": {
            "type": "string",
            "enum": [
              "invalid_item", "unknown_field", "invalid_type", "missing_required",
              "invalid_value", "invalid_cas", "compound_not_found",
              "experimental_data_unavailable", "estimation_failed"
            ]
          },
          "field": {"type": "string"},
          "module": {"type": "string"},
          "message": {"type": "string"}
        }
