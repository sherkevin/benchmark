+        stats['degraded_entities'] = sum(len(v['entity_ids'])
+                                         for v in universe.values()
+                                         if v['key_type'] == 'degraded')
+        _MATERIAL_KEY_FULL_CACHE[root] = (universe, stats)
+        self._material_universe_full_stats = stats
