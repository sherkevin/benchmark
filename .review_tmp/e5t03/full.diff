+        if iso:
+            comp[iso] = comp.get(iso, 0) + 1
+            continue
+        if e2l is None:
+            e2l = _element_to_label_map()
+        sym = atom.GetSymbol()
+        if sym not in e2l:
+            return None
+        comp[e2l[sym]] = comp.get(e2l[sym], 0) + 1
+    return comp or None
