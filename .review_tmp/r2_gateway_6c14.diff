+def _load_case_view_fns():
+    """E1-05 视图机制懒加载接缝（仿 material_identity 先例）：返
+    (load_view, validate_view)；import 失败返 (None, None)（调用侧按
+    fail-closed 处置：open 构造即 raise，不静默降级）。"""
+    global _VIEW_IMPORT_WARNED
+    try:
+        import sys
+        root = os.path.dirname(HERE)
+        if root not in sys.path:
+            sys.path.insert(0, root)
+        from src.data_build.per_case_view import load_view, validate_view
+        return load_view, validate_view
+    except Exception as e:  # noqa: BLE001 接缝容错：处置由调用侧按 kind 裁定
+        if not _VIEW_IMPORT_WARNED:
+            _VIEW_IMPORT_WARNED = True
+            logging.warning(
+                'per-case 视图机制（src.data_build.per_case_view）装载失败：%r', e)
+        return None, None
+
+
+def _resolve_case_view(case_id, case_kind):
+    """会话构造期统一视图装载（F1：一条代码路径，不写两套）。
+
+    返 (view_dict | None, visible_ids: set | None, visible_docs: set | None)：
+      view=None 即全库口径（无过滤）。case_id 缺省（构造参数与 env
+    DAGPOC_CASE_ID 均无）→ 直接全库（既有调用方零改动）。
+      case_kind=='open'：视图不在场/校验失败/装载机制不可用 → raise
+    ValueError（错误码 CASE_VIEW_MISSING，fail-closed）；构造期 fail fast，
+    与 b_set/G_B 构造断言同款风格。文案不含库规模/白名单内容（防源探测）。
+      case_kind 为 'fixed'/None：缺视图容忍返 None（全库口径）；视图在场
+    且校验通过则同样生效过滤（统一路径：fixed 类将来配视图自动生效）。"""
+    if not case_id:
+        return None, None, None
+    load_view, _validate = _load_case_view_fns()
+    err = None
+    view = None
+    if load_view is None:
+        err = '视图装载机制不可用（src.data_build.per_case_view import 失败）'
+    else:
+        try:
+            view = load_view(case_id)   # 自带 validate_view 载入期校验
+        except OSError:
+            err = f'视图文件不在场（per_case_views/{case_id}.json）'
+        except ValueError as e:
+            err = f'视图校验失败：{e}'
+    if view is None:
+        if case_kind == 'open':
+            raise ValueError(
+                f'CASE_VIEW_MISSING：open 类 case {case_id!r} 未注册可用 '
+                f'per-case 视图（{err}），fail-closed 拒绝构造——不得静默'
+                '回落全库（task-05 §10 / PR-40）')
+        logging.info('case %r 无可用视图（kind=%r），走全库口径',
+                     case_id, case_kind)
+        return None, None, None
+    visible_ids = set(view['visible_entity_ids'])
+    visible_docs = set(view.get('literature_doc_ids') or [])
+    return view, visible_ids, visible_docs
+
