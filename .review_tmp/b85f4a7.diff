+def _extract_new(events):
+    """新契约 9 工具出参形状抽取（任务 #45 / task-04 §1.4 要求 1：逐工具对齐
+    tools_schema.json output 定义），重组为六元组同一语义：
+      literature_search  papers[].doc_id（新形状；旧读 doi 恒空）→ lit_dois
+      search_candidates  candidates[].id（旧 search_molecule_database
+                         results[].name 语义位）→ mol_ids
+      get_entity         {id, entity_type, structure}：旧 get_cif_by_formula 的
+                         cif 语义对应位——晶体 id 入 cif_ids；分子侧结构档无
+                         判分语义不入集合
+      get_property       {id, values[]{name,value}} 嵌套重组为扁平
+                         {molecule:<id>, <name>:<value>} 追加 admet_results
+                         （gold_pass_set/_score_fixed 的 r.get(c['property'])/
+                         r.get('molecule') 零改动），id 入 admet_ids
+      compare            ordered_ids 排序证据（旧 compare_materials 读
+                         sorted_results[].cif_key）→ 双域入 mol_ids+cif_ids
+      check_molecule_exists / edit_molecule / normalize_structure /
+      submit_answer      无判分语义，跳过不崩
+    统一错误信封 {error_code, error} 显式跳过（不当空数据静默吞）；
+    args/ret 双形态经 _event_args_ret（网关录像行与 legacy trace 行均兼容）。"""
+    lit_dois, mol_ids, admet_ids, admet_results = set(), set(), set(), []
+    cif_ids, crystal_results = set(), []
+    for e in events:
+        tool = e.get('tool')
+        _, ret = _event_args_ret(e)
+        if not isinstance(ret, dict) or 'error_code' in ret:
+            continue
+        if tool == 'literature_search':
+            for p in ret.get('papers', []):
+                if isinstance(p, dict) and p.get('doc_id'):
+                    lit_dois.add(p['doc_id'])
+        elif tool == 'search_candidates':
+            for c in ret.get('candidates', []):
+                if isinstance(c, dict) and c.get('id'):
+                    mol_ids.add(c['id'])
+        elif tool == 'get_entity':
+            if ret.get('entity_type') == 'crystal' and ret.get('id'):
+                cif_ids.add(ret['id'])
+        elif tool == 'get_property':
+            eid = ret.get('id')
+            values = ret.get('values')
+            if eid and isinstance(values, list) and values:
+                flat = {'molecule': eid}
+                for item in values:
+                    if isinstance(item, dict) and item.get('name') is not None:
+                        flat[item['name']] = item.get('value')
+                admet_ids.add(eid)
+                admet_results.append(flat)
+        elif tool == 'compare':
+            for oid in ret.get('ordered_ids', []):
+                if isinstance(oid, str) and oid:
+                    mol_ids.add(oid)    # 药物域：cp2 候选池 grounded 证据
+                    cif_ids.add(oid)    # 材料域：旧 compare_materials 语义位
+        # check_molecule_exists / edit_molecule / normalize_structure /
+        # submit_answer：无判分语义，跳过
+    return lit_dois, mol_ids, admet_ids, admet_results, cif_ids, crystal_results
