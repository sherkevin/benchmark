+# ── 分派探测（显式名单判定）─────────────────────────────────────────────────
+
+def test_dispatch_new_contract_pure():
+    """工具名全在新契约 9 工具内 → 新分支（抽取面与 _extract_new 一致）。"""
+    assert E.extract_tool_data(NEW_EVENTS) == E._extract_new(NEW_EVENTS)
+
+
+def test_dispatch_legacy_pure_and_mixed():
+    """纯旧名与 MIXED（旧名+新名混用）均归 legacy 分支。"""
+    assert E.extract_tool_data(LEGACY_EVENTS) == E._extract_legacy(LEGACY_EVENTS)
+    mixed = NEW_EVENTS + [{'tool': 'predict_admet', 'result': {'results': []}}]
+    assert E.extract_tool_data(mixed) == E._extract_legacy(mixed)
+    # 空 trace 归 legacy（口径零变化：全空六元组）
+    assert E.extract_tool_data([]) == (set(), set(), set(), [], set(), [])
+
+
+def test_dispatch_real_traces():
+    """真实 trace 分派实证（仓库内只读）：legacy 9 组 trace 含旧工具名归
+    legacy；新契约 trace（cardiac/cns 系）工具名 ⊆ 9 工具归新分支。"""
+    legacy_trace = os.path.join(
+        DAG_POC, 'traces', 'case_antibiotic_sulfamethoxazole__qwen3.7-max.jsonl')
+    new_trace = os.path.join(
+        DAG_POC, 'traces', 'case_cns_metoprolol__bailian_glm-5.2.jsonl')
+    for path, branch in ((legacy_trace, E._extract_legacy),
+                         (new_trace, E._extract_new)):
+        events = [json.loads(l) for l in open(path, encoding='utf-8')]
+        assert E.extract_tool_data(events) == branch(events), path
+
