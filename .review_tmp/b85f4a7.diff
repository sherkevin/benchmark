+    _ev('compare', {'ordered_ids': ['aa', 'ab', 'ac']}),
+    _ev('check_molecule_exists', {'exists': True}),
+    _ev('edit_molecule', {'result_id': 'p1', 'applied': True}),
+    _ev('normalize_structure', {'canonical_id': 'c1ccccc1', 'valid': True}),
+    _ev('submit_answer', {'accepted': True}),
