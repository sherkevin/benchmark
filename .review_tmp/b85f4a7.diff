+    _ev('search_candidates', {'candidates': [
+        {'id': 'aa', 'entity_type': 'molecule', 'structure_hint': 'FORMULA:[16*]15'},
+        {'id': 'ab', 'entity_type': 'molecule', 'structure_hint': 'FORMULA:[19*]25'}]}),
+    _ev('search_candidates', {'error_code': 'EMPTY_RESULT', 'error': '检索无命中'}),
+    _ev('get_entity', {'id': 'xa', 'entity_type': 'crystal',
+                       'structure': {'formula': 'FORMULA:[20*]99',
+                                     'masked_structure': 'FORMULA:[20*]99;SPACEGROUP:I 4/m m m',
