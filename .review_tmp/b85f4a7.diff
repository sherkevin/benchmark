+# ── _extract_new 逐工具映射 ─────────────────────────────────────────────────
+
+def test_extract_new_per_tool_mapping():
+    """9 工具逐形状映射：lit doc_id / candidates[].id / 晶体 cif_ids /
+    get_property 扁平重组 / compare 双域；无语义 4 工具跳过不崩。"""
+    lit, mol, admet_ids, admet_results, cif, crystal = E._extract_new(NEW_EVENTS)
+    assert lit == {'10.1000/a', '10.1000/b'}
+    assert mol == {'aa', 'ab', 'ac'}          # search_candidates + compare 合并
+    assert cif == {'xa', 'aa', 'ab', 'ac'}    # get_entity 晶体 + compare 双域
+    assert admet_ids == {'aa'}                # 空 values 的 ab 不入
+    assert admet_results == [{'molecule': 'aa', 'bbb': 1, 'caco2': -4.35}]
+    assert crystal == []                      # 新契约无 crystal_results 语义位
+    # 扁平重组直接喂 gold_pass_set 零改动（判分公式消费面验证）
+    gps = E.gold_pass_set(admet_results,
+                          [{'property': 'bbb', 'op': '==', 'threshold': 1}])
+    assert gps == {'aa'}
+
+
+def test_extract_new_error_envelope_skipped():
+    """统一错误信封 {error_code} 显式跳过——不当空数据静默吞，也不崩。"""
+    evs = [_ev('search_candidates', {'error_code': 'EMPTY_RESULT', 'error': 'x'}),
+           _ev('get_property', {'error_code': 'UNKNOWN_ENTITY', 'error': 'x'}),
+           _ev('literature_search', {'error_code': 'BUDGET_EXCEEDED', 'error': 'x'})]
+    assert E._extract_new(evs) == (set(), set(), set(), [], set(), [])
+
+
+def test_extract_new_args_ret_dual_form():
+    """网关录像行（args/ret）与 legacy 行形态（arguments/result）均兼容。"""
+    ev = {'tool': 'literature_search',
+          'result': {'papers': [{'doc_id': '10.1000/c'}]}}
+    lit, *_ = E._extract_new([ev])
+    assert lit == {'10.1000/c'}
+
+
+# ── _extract_legacy 口径冻结 ────────────────────────────────────────────────
+
+def test_extract_legacy_frozen_semantics():
+    """legacy 6 工具名抽取口径逐字段冻结（原 extract_tool_data 原样搬移）。"""
+    lit, mol, admet_ids, admet_results, cif, crystal = E._extract_legacy(LEGACY_EVENTS)
+    assert lit == {'10.9/old'}                 # 旧形状读 doi（非 doc_id）
+    assert mol == {'ma'}
+    assert admet_ids == {'ma'}                 # 含 error 的 mb 不入
+    assert admet_results == [{'molecule': 'ma', 'bbb': 1}]
+    assert cif == {'xa_exp_1', 'xb_exp_1'}
+    assert crystal == [{'cif_key': 'xb_exp_1', 'tc': 90},
+                       {'cif_key': 'xa_exp_1', 'tc': 92}]
+
+
+# ── 实跑冒烟：新契约 trace 判分非 0（§1.4 要求 4 的证据面）──────────────────
+
+def test_new_contract_trace_scores_nonzero():
+    """真实新契约 trace（仓库内只读）经新分支抽取后 cp1-cp5 出现非 0——
+    cns_metoprolol__bailian_glm-5.2 人工核过：cp1=1（lit 2 篇）、
+    gps={aa,ec}、cp4=0.4（ranked∩gps=2/10）、cp5=1.0（gold 前二序一致）、
+    cp6=0.5（best=ec∈gps 但非 gt=aa）。"""
+    case_path = os.path.join(DAG_POC, 'templates', 'fixed_discovery',
+                             'case_cns_metoprolol.json')
+    trace_path = os.path.join(DAG_POC, 'traces',
+                              'case_cns_metoprolol__bailian_glm-5.2.jsonl')
+    resp_path = trace_path.replace('.jsonl', '_response.json')
+    response = json.load(open(resp_path, encoding='utf-8')).get('response')
+    scores, gps, ranked, best = E.score_case(case_path, trace_path, response)
+    assert scores['cp1'] == 1.0
+    assert scores['cp2'] > 0 and scores['cp3'] > 0
+    assert scores['cp4'] > 0 and scores['cp5'] > 0
+    assert sorted(gps) == ['aa', 'ec']
+    assert abs(scores['cp4'] - 0.4) < 1e-9 and scores['cp5'] == 1.0
+    assert best == 'ec' and scores['cp6'] == 0.5
