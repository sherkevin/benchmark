+
+def _ev(tool, ret, args=None):
+    """网关录像行形态事件（args/ret 双形态之一）。"""
+    return {'t': 1, 'tool': tool, 'args': args or {}, 'ret': ret, 'ok': True}
+
+
+NEW_EVENTS = [
+    _ev('literature_search', {'total_found': 2, 'papers': [
+        {'doc_id': '10.1000/a', 'title': 't1', 'year': 2020, 'citation_count': 3},
