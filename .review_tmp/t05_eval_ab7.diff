+def _existence_budget_status(events):
+    """存在性查证预算状态扫描（任务 #52 / task-05 §1.2 约束 3 / ADR-0018 §4 H4）。
+
+    只扫 trace 录像中 check_molecule_exists 行，返 {'attempts', 'exhausted'}：
+      attempts  = 成功信封行数（服务端真实计数口径的 trace 侧镜像，供 goal §6
+                  步 6 平均 attempts 指标）；
+      exhausted = trace 中出现 ATTEMPTS_EXCEEDED 信封行（超预算拒绝）。
+
+    【H5 自证循环纪律，最高红线】本函数只消费错误码与行计数，绝不消费
+    exists 返值——评分依据仍是 ∈G_B（hit_gb 经 B 分区读取器独立重判）且经
+    B 侧性质复核；接口返 true 只是 agent 的停止信号。任何把 exists 接入得分
+    的改动都构成自证循环并可被暴力枚举攻破（goal §2b⑤ / ADR-0018 §4.3）。
+    超限是“预算耗尽罚 0”，不是“接口返存在→得分”。
+    旧 open 类（open_discovery 4 case，旧契约工具集）无该工具调用，永不触发；
+    fixed 类同理——本判据只对 open 判分链生效。"""
+    attempts, exhausted = 0, False
+    for e in events:
+        if e.get('tool') != 'check_molecule_exists':
+            continue
+        _, ret = _event_args_ret(e)
+        if not isinstance(ret, dict):
+            continue
+        if ret.get('error_code') == 'ATTEMPTS_EXCEEDED':
+            exhausted = True
+        elif 'error_code' not in ret:
+            attempts += 1
+    return {'attempts': attempts, 'exhausted': exhausted}
+
