+        lines.append(f'    SPACEGROUP 段: {sg}')
+        lines.append(f'    现算键: {G.material_key_from_record(rec)}')
+        lines.append(f"    键列值: {key_column[cid]}（== {G.material_key_from_record(rec) == key_column[cid]}）")
+    sg64 = next(cid for cid, k in key_column.items() if k.endswith('_SG64'))
+    lines.append(f'  SG64 旧记法样本 {sg64}: SPACEGROUP 段=C m c a（别名表兜底）'
+                 f'，现算键={G.material_key_from_record(ent_records[sg64])}')
+    lines += [
+        '',
+        '## grounding 条件②接通实测',
+        '  锚点=材料身份键形态 → anchor_in_A=True（整串 == 口径）',
+        '  伪键（错空间群号）/ 仅 reduced_formula 半串 → anchor_in_A=False',
+        '',
+        '## 判别力评估结论',
+        '  键覆盖率 5,771/5,771（100%）、唯一键 5,740；31 组碰撞全部为 3DSC 上游',
+        '  重复录入（同材料重复登记），不存在"不同晶体同键"——同键判等是正确行为，',
+        '  判别力充分支撑 grounding == 判定（造题去重归 E5）。',
+        '',
+        '## 边界登记',
+        '  材料版 edit_op 算子集未就位（ADR-0017 §4 另定）→ grounding 条件③的',
+        '  edit_op 施加半边暂无算子，材料侧只接通条件②锚点 == 比对；open 材料题',
+        '  在算子集就位前本就不造（E5 约束）。标注不改（task-03 §2 未要求材料侧）。',
+        '',
+    ]
+    with open(MATERIAL_REALDATA_LOG, 'w', encoding='utf-8') as f:
+        f.write('\n'.join(lines))
