+class AIdentityBackendJsonlReader:
+    """A 侧身份档读取器（任务 #36 / task-03 §1：接 E1 匿名层，ADR-0017）。
+
+    照 BPartitionBackendJsonlReader 同款模式：目录扫描 backend 物理分层布局、
+    只读不写；A 侧读取白名单只许 *_A.jsonl。只装载两库：
+      - get_entity/get_entity_A.jsonl：身份档（formula/masked_structure/
+        atom_count 全部匿名域字段，E1-03 交接说明 §二.1）；
+      - search_candidates/search_candidates_A.jsonl：匿名域 smiles 列。
+
+    映射表纪律（task-03 §1 切换纪律 3）：本读取器与网关一切读路径不得
+    import anonymization_mapping.json（映射表只服务 judge 侧评分反查）；
+    dummy SMILES 规范化靠 RDKit canonical 即可 ==（E1-03 交接 §一.1：匿名域
+    SMILES 满足一步不动点）。"""
+
+    def __init__(self, backend_root=DEFAULT_BACKEND_ROOT):
+        self.backend_root = backend_root
+
+    def _a_file(self, tool, name):
+        """A 侧白名单校验 + 路径探测；文件不在场返 None（回落兼容）。"""
+        if not name.endswith('_A.jsonl'):
+            raise ValueError(
+                f'A 侧读取白名单只允许 *_A.jsonl，拒绝加载：{name}')
+        path = os.path.join(self.backend_root, tool, name)
+        return path if os.path.exists(path) else None
+
+    def load(self):
+        """返 (entity_records, smiles_map)；任一文件不在场返 (None, None)——
+        回落 mock_db 派生口径（过渡期兼容，行为零回退）。"""
+        ent_path = self._a_file('get_entity', 'get_entity_A.jsonl')
+        smi_path = self._a_file('search_candidates', 'search_candidates_A.jsonl')
+        if ent_path is None or smi_path is None:
+            return None, None
+        entities = {}
+        with open(ent_path, encoding='utf-8') as f:
+            for line in f:
+                line = line.strip()
+                if line:
+                    rec = json.loads(line)
+                    entities[rec['id']] = rec
+        smiles = {}
+        with open(smi_path, encoding='utf-8') as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                rec = json.loads(line)
+                if rec.get('smiles'):
+                    smiles[rec['id']] = rec['smiles']
+        return entities, smiles
+
+
+_A_IDENTITY_CACHE = {}
+
+
+def _load_a_identity(reader):
+    """A 侧身份档装载（模块级懒缓存：8 万行级 jsonl 每个 backend 根只扫一遍，
+    避免每个 Gateway 构造重复全载；测试用临时 backend 根以路径为键互不串扰）。"""
+    if reader is None:
+        return None, None
+    key = reader.backend_root
+    if key not in _A_IDENTITY_CACHE:
+        _A_IDENTITY_CACHE[key] = reader.load()
+    return _A_IDENTITY_CACHE[key]
+
+
+def default_a_identity_reader(backend_root=None):
+    """默认 A 侧身份读取器：backend 布局在场返 JSONL 读取器，否则 None。"""
+    root = backend_root or DEFAULT_BACKEND_ROOT
+    if not os.path.isdir(root):
+        return None
+    return AIdentityBackendJsonlReader(root)
+
+
+# 匿名红线自检（任务 #36，E1-03 交接说明 §一.2 第②条）：agent 可见身份字段
+# 不得匹配真实身份形态——① InChIKey 正则；② 真实元素分子式（元素符号+下标
+# 组成、不含 dummy atom 方括号；匿名域分子式为 [N*]计数 形态必含 '['）。
+# 与 E1 自检脚本 check_agent_visible_anonymity.py 同口径（ADR-0017 影响分工表）。
+_INCHIKEY_RE = re.compile(r'^[A-Z]{14}-[A-Z]{10}-[A-Z0-9]$')
+_REAL_FORMULA_RE = re.compile(r'^(?:[A-Z][a-z]?\d*)+$')
+
+
+def _assert_anon_identity_fields(*fields):
+    """get_entity 返回的身份字段红线断言：出现真实身份形态立即 raise
+    （ADR-0017 §2：匿名域不得携带真实身份，不带病运行）。"""
+    for v in fields:
+        if not isinstance(v, str) or not v:
+            continue
+        if _INCHIKEY_RE.match(v):
+            raise ValueError(
+                f'身份字段疑似真实 InChIKey（ADR-0017 红线）：{v[:24]}…')
+        if '[' not in v and _REAL_FORMULA_RE.match(v):
+            raise ValueError(
+                f'身份字段疑似真实元素分子式（ADR-0017 红线）：{v}')
+
+
+# ── 材料侧身份键（任务 #37 / task-03 §2：接 E1-04 交付，ADR-0017 §4）───────────
+# 键形态 = <匿名域 reduced_formula>_SG<空间群号>（E1-04 交接说明 §2：
+# src/data_build/material_identity.py 纯函数，只读引用不改）。
+# 取用走接口 B（现算，零 IO、无映射表依赖）：入参即 A 侧可见字段
+# （get_entity_A.formula + masked_structure 的 SPACEGROUP 段）。
+# 纪律：键只在 judge/评分侧做 grounding == 比对（交接说明 §4.2/§5），
+# 不进任何工具返回值（agent 可见面零增量，E1-04 §4.3）。
+_SPACEGROUP_RE = re.compile(r'SPACEGROUP:([^;]+)')
+_MATERIAL_KEY_CACHE = {}
+_SG_NUMBER_CACHE = {}
+
+
+def _load_material_identity_fns():
+    """E1-04 接口 B 懒加载接缝：返 (material_identity_key,
+    reduced_formula_anon, sg_symbol_to_number) 三纯函数；import 失败
+    （模块不在场/pymatgen 缺包）返 (None, None, None)（材料侧 grounding
+    路径回落旧行为，不崩不带病）。src.data_build 在仓库根，网关在
+    dag_poc/，按需补仓库根入 sys.path。"""
+    try:
+        import sys
+        root = os.path.dirname(HERE)
+        if root not in sys.path:
+            sys.path.insert(0, root)
+        from src.data_build.material_identity import (
+            material_identity_key, reduced_formula_anon, sg_symbol_to_number)
+        return material_identity_key, reduced_formula_anon, sg_symbol_to_number
+    except Exception:  # noqa: BLE001 接缝容错：缺依赖不得阻断网关装载
+        return None, None, None
+
+
+def material_key_from_record(rec):
+    """晶体身份档 → 材料侧身份键（接口 B 现算，零 IO）：formula（匿名式）+
+    masked_structure 的 SPACEGROUP 段。拼装口径与 E1 material_identity_key
+    逐字一致（<reduced_formula>_SG<空间群号>，交接说明 §2）；空间群号
+    按符号缓存在进程内（去重后仅 135 种，pymatgen SpaceGroup 单次构造
+    ~20ms，不缓存则全量 5,771 次 ~2 分钟——评分路径不可接受）。
+    解析失败/函数不在场 → None；测试以接口 B 直调对照防拼装漂移。"""
+    _, reduced_fn, sg_fn = _load_material_identity_fns()
+    if reduced_fn is None or not isinstance(rec, dict):
+        return None
+    m = _SPACEGROUP_RE.search(rec.get('masked_structure') or '')
+    if not m:
+        return None
+    symbol = m.group(1).strip()
+    try:
+        if symbol not in _SG_NUMBER_CACHE:
+            _SG_NUMBER_CACHE[symbol] = sg_fn(symbol)
+        return '{}_SG{}'.format(reduced_fn(rec.get('formula')),
+                                _SG_NUMBER_CACHE[symbol])
+    except Exception:  # noqa: BLE001 脏行不得穿透评分路径
+        return None
+
