+#!/usr/bin/env python3
+"""test_material_identity_grounding.py —— 任务 #37（task-03 §2）：材料侧身份键
+接入与判别力实跑验证（E1-04 交付，ADR-0017 §4）。
+
+覆盖四块：
+  1. 全量键列等价：gateway 接口 B 现算键（空间群号按符号缓存拼装）与 E1-04
+     judge 侧键列（接口 A，material_identity_keys.jsonl）5,771/5,771 逐一相同，
+     唯一键 5,740、冲突 31 组全部为上游重复录入（同键判等是正确行为）；
+  2. 真实数据样本实跑：get_entity_A.jsonl 晶体记录（A 侧可见字段：匿名
+     formula + masked_structure SPACEGROUP 段）现算键与键列 == 比对，含
+     小数计量/SG64 旧记法别名/零计量/分子单质四类边界样本；
+  3. grounding 条件②接通：anchor_molecules 为材料身份键形态时判
+     anchor_in_A=True（整串 == 口径），伪键拒绝；
+  4. 接缝容错：脏记录/缺 SPACEGROUP 段返 None 不穿透。
+
+证据落盘：rehearsal_logs/material_identity_key_realdata.log（沿 E1 惯例）。
+
+运行：
+  python3 -m pytest dag_poc/mcp_mock_server/tests/test_material_identity_grounding.py -q
+"""
+
+import datetime
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+DAG_POC = os.path.abspath(os.path.join(HERE, '..', '..'))
+REPO_ROOT = os.path.abspath(os.path.join(DAG_POC, '..'))
+sys.path.insert(0, DAG_POC)
+sys.path.insert(0, os.path.join(REPO_ROOT, 'src', 'benchmark'))
+sys.path.insert(0, REPO_ROOT)
+
+import evaluate as E                              # noqa: E402
+import gateway as G                                # noqa: E402
+
+# E1-04 judge 侧键列（接口 A，只作验证对照；生产判定走接口 B 现算）
+KEY_COLUMN_PATH = os.path.join(
+    REPO_ROOT, 'src', 'data_build', '_build_state', 'material_identity_keys.jsonl')
+MATERIAL_REALDATA_LOG = os.path.join(
+    HERE, '..', 'rehearsal_logs', 'material_identity_key_realdata.log')
+
+
+def _load_key_column():
+    """接口 A 键列：{id: material_identity_key}。"""
+    out = {}
+    with open(KEY_COLUMN_PATH, encoding='utf-8') as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                rec = json.loads(line)
+                out[rec['id']] = rec['material_identity_key']
+    return out
+
+
+def test_material_key_recompute_matches_key_column():
+    """全量等价（E3 侧独立复核，对应 E1-04 自检 S2）：接口 B 现算键与
+    judge 侧键列 5,771/5,771 逐一相同；唯一键 5,740、冲突组 31（全部
+    上游重复录入，同键判等是正确行为，E1-04 交接 §3）。证据同步写盘。"""
+    gw = G.Gateway()
+    ent_records, _ = gw._a_identity
+    key_column = _load_key_column()
+    assert len(key_column) == 5771
+    mismatch = []
+    for cid, expect in key_column.items():
+        rec = ent_records.get(cid)
+        assert rec is not None and rec.get('entity_type') == 'crystal', cid
+        got = G.material_key_from_record(rec)
+        if got != expect:
+            mismatch.append((cid, got, expect))
+    assert not mismatch, f'现算键与键列不一致 {len(mismatch)} 条：{mismatch[:3]}'
+    # 键全集：唯一键 5,740；冲突组 31 全部恰 2 条/组（上游重复录入）
+    universe = gw._material_key_universe()
+    assert len(universe) == 5740
+    from collections import Counter
+    cnt = Counter(G.material_key_from_record(ent_records[c])
+                  for c in key_column)
+    dup_groups = {k: n for k, n in cnt.items() if n > 1}
+    assert len(dup_groups) == 31 and set(dup_groups.values()) == {2}
+    _write_material_realdata_log(key_column, ent_records, universe, dup_groups)
+
+
+def test_material_key_realdata_samples():
+    """真实数据样本实跑：键生成 + == 比对 + 确定性（同输入重算恒等）。
+    样本覆盖四类边界（E1-04 交接 §7.2 已踩坑清单）：
+    小数计量 / SG64 旧记法 'C m c a' / 零计量 c04294 / 分子单质 c05146。"""
+    gw = G.Gateway()
+    ent_records, _ = gw._a_identity
+    key_column = _load_key_column()
+    # 首行样本（交接说明示例）：小数计量归约 1.98/0.02 → 99/1/50/100
+    rec = ent_records['c00001']
+    assert G.material_key_from_record(rec) == '[20*]99[32*]50[42*][48*]100_SG139'
+    assert G.material_key_from_record(rec) == key_column['c00001']
+    # SG64 旧记法别名样本：键列中空间群号 64 的晶体走 'C m c a' 别名表
+    sg64_ids = [cid for cid, k in key_column.items() if k.endswith('_SG64')]
+    assert sg64_ids, '键列应含 SG64（旧记法 C m c a）晶体'
+    for cid in sg64_ids[:3]:
+        assert 'SPACEGROUP:C m c a' in ent_records[cid]['masked_structure']
+        assert G.material_key_from_record(ent_records[cid]) == key_column[cid]
+    # 零计量 / 分子单质定名样本
+    for cid in ('c04294', 'c05146'):
+        assert G.material_key_from_record(ent_records[cid]) == key_column[cid], cid
+    # 确定性：同输入重算恒等（== 比对前提）
+    for cid in ('c00001', 'c04294', 'c05146'):
+        assert (G.material_key_from_record(ent_records[cid])
+                == G.material_key_from_record(ent_records[cid]))
+
+
+def test_grounding_anchor_accepts_material_identity_key():
+    """grounding 条件②接通（任务 #37 落点）：anchor_molecules 为材料身份键
+    形态（<reduced_formula>_SG<号>）时 anchor_in_A=True——晶体无 SMILES，
+    键是材料侧唯一身份判据（整串 == 比对，E1-04 交接 §7.3：不得只比
+    reduced_formula 部分）；伪键/只比半串均拒绝。"""
+    gw = G.Gateway()
+    universe = gw._material_key_universe()
+    real_key = next(iter(universe))
+    # 真键：anchor_in_A=True（cited_values 空列表合法、edit_op 缺省不影响②）
+    payload = {'cited_values': [], 'anchor_molecules': [real_key],
+               'edit_op': None, 'answer': universe[real_key]}
+    result = E.evaluate_grounding(payload, [])
+    assert result['anchor_in_A'] is True, result['details']
+    # 伪键（真公式配错空间群号）：拒绝
+    reduced = real_key.split('_SG')[0]
+    fake = reduced + '_SG999'
+    payload_fake = dict(payload, anchor_molecules=[fake])
+    assert E.evaluate_grounding(payload_fake, [])['anchor_in_A'] is False
+    # 只比半串（仅 reduced_formula）：拒绝（整串比对纪律）
+    payload_half = dict(payload, anchor_molecules=[reduced])
+    assert E.evaluate_grounding(payload_half, [])['anchor_in_A'] is False
+
+
+def test_material_key_seam_fault_tolerant():
+    """接缝容错：脏记录/缺 SPACEGROUP 段/非 dict → None，不穿透评分路径。"""
+    assert G.material_key_from_record(None) is None
+    assert G.material_key_from_record({'formula': '[1*]1'}) is None
+    assert G.material_key_from_record(
+        {'formula': '[1*]1', 'masked_structure': 'FORMULA:[1*]1'}) is None
+    # 非法匿名式（解析失败）→ None（不 raise）
+    assert G.material_key_from_record(
+        {'formula': 'garbage', 'masked_structure': 'SPACEGROUP:P 1'}) is None
+
+
+def _write_material_realdata_log(key_column, ent_records, universe, dup_groups):
+    """材料侧身份键实跑证据落盘（沿 E1 rehearsal_logs 惯例；每次运行覆写
+    为当次实跑留痕，测试绿即证据新）。"""
+    os.makedirs(os.path.dirname(MATERIAL_REALDATA_LOG), exist_ok=True)
+    samples = ['c00001', 'c04294', 'c05146']
+    lines = [
+        '# 材料侧身份键实跑证据（任务 #37 / task-03 §2）',
+        f'# 生成时刻: {datetime.datetime.now().isoformat(timespec="seconds")}',
+        '# 生成方式: test_material_identity_grounding.py::test_material_key_recompute_matches_key_column',
+        '# 接口: B（src/data_build/material_identity.py 纯函数现算，零 IO、无映射表依赖）',
+        '# 入参: A 侧可见字段（get_entity_A.formula + masked_structure 的 SPACEGROUP 段）',
+        '',
+        '## 全量等价复核（E3 侧独立重跑，对应 E1-04 自检 S2）',
+        f'  键列规模: {len(key_column)} 条（接口 A 对照源）',
+        f'  接口 B 现算 == 键列: {len(key_column)}/{len(key_column)} 逐一相同',
+        f'  唯一键数: {len(universe)}（冲突组 {len(dup_groups)}，全部上游重复录入，同键判等是正确行为）',
+        '',
+        '## 样本摘录（键生成与 == 比对）',
+    ]
+    for cid in samples:
+        rec = ent_records[cid]
