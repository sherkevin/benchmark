\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Pre-call selection on BBB. MIRA-Relay matches the frozen selector on the natural menu and improves recovery under controlled correctness drift.}}{1}{table.1}\protected@file@percent }
\newlabel{tab:main-results}{{1}{1}{\MiraMainCaption }{table.1}{}}
\newlabel{tab:mechanism-results}{{1}{1}{\MiraMainCaption }{table.1}{}}
