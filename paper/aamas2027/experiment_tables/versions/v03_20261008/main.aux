\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Delay sensitivity. Each point is a descriptive paired gain over Frozen at one recorded delay, not an independent task cohort or a confidence interval.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:delay-sensitivity}{{1}{1}{\MiraDelayCaption }{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Source-aligned feedback attribution. Only the destination of each released residual changes; cold start and release clock are matched.}}{1}{table.2}\protected@file@percent }
\newlabel{tab:credit-ablation}{{2}{1}{\MiraCreditCaption }{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cold-start accuracy on BBB development. The per-molecule oracle is evaluator-only.}}{2}{table.3}\protected@file@percent }
\newlabel{tab:learned-prior}{{3}{2}{\MiraPriorCaption }{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Score scale and update rule on BBB development. Accuracy in \%.}}{2}{table.4}\protected@file@percent }
\newlabel{tab:centering-diagnostic}{{4}{2}{\MiraCenterCaption }{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces CPU policy overhead in $\mu $s. The lightweight residual update has lower measured overhead than the matched gradient and posterior updates.}}{2}{table.5}\protected@file@percent }
\newlabel{tab:cost-validity}{{5}{2}{\MiraCostCaption }{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Post-call refusal on the existing held-out cohort (secondary analysis). Confidence gating improves accepted accuracy at matched coverage.}}{2}{table.6}\protected@file@percent }
