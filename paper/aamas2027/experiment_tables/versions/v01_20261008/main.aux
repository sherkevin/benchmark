\newlabel{tab:centering-diagnostic}{{4}{3}{\MiraCenterCaption }{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Policy-operation cost under the one-call contract. Values are means of the 30 recorded stream-level p95 timings per method, in $\mu $s on macOS arm64; they are not the p95 of all pooled operations or end-to-end service latency.}}{3}{table.5}\protected@file@percent }
\newlabel{tab:cost-validity}{{5}{3}{\MiraCostCaption }{table.5}{}}
