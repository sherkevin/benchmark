\newlabel{tab:credit-ablation}{{2}{2}{\MiraCreditCaption }{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cold-start selection and task headroom on 722 development molecules. Five scaffold OOF folds; BCE/BT share architecture, initialization, optimization budget, and validation selection.}}{3}{table.3}\protected@file@percent }
\newlabel{tab:learned-prior}{{3}{3}{\MiraPriorCaption }{table.3}{}}
